  "casosDeUso": [
    {
      "id": "CU2",
      "nombre": "Cancelar Vuelo",
      "actor": "EncargadoNavegacion",
      "pasos": [
        {
          "nro": 1,
          "quien": "Actor",
          "texto": "selecciona la opción Cancelar Vuelo"
        },
        {
          "nro": 2,
          "quien": "Sistema",
          "texto": "muestra los vuelos posibles de cancelar (número, origen, destino, horario)",
          "reglas": [
            "RN7"
          ]
        },
        {
          "nro": 3,
          "quien": "Actor",
          "texto": "selecciona un vuelo"
        },
        {
          "nro": 4,
          "quien": "Sistema",
          "texto": "requiere seleccionar un motivo de cancelación"
        },
        {
          "nro": 5,
          "quien": "Actor",
          "texto": "selecciona un motivo de cancelación"
        },
        {
          "nro": 6,
          "quien": "Sistema",
          "texto": "solicita ingresar una descripción"
        },
        {
          "nro": 7,
          "quien": "Actor",
          "texto": "ingresa la descripción"
        },
        {
          "nro": 8,
          "quien": "Sistema",
          "texto": "solicita confirmar la cancelación"
        },
        {
          "nro": 9,
          "quien": "Actor",
          "texto": "confirma la cancelación"
        },
        {
          "nro": 10,
          "quien": "Sistema",
          "texto": "registra motivo, descripción, fecha, hora y usuario responsable; actualiza el estado a Cancelado y notifica a los interesados"
        }
      ],
      "alternativos": [
        {
          "id": "A1",
          "texto": "No existen vuelos posibles de cancelar"
        },
        {
          "id": "A2",
          "texto": "No confirma la cancelación"
        },
        {
          "id": "A3",
          "texto": "El EN cancela la ejecución del CU"
        }
      ],
