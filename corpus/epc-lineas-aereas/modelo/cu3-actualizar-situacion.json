  "casosDeUso": [
    {
      "id": "CU3",
      "nombre": "Actualizar situación de Vuelo (escenario Aterrizar)",
      "actor": "EncargadoNavegacion",
      "pasos": [
        {
          "nro": 1,
          "quien": "Actor",
          "texto": "selecciona la opción Actualizar situación de Vuelo"
        },
        {
          "nro": 2,
          "quien": "Sistema",
          "texto": "busca y muestra las opciones de actualización de estado (vuelos en estado no final) y solicita qué estado actualizar"
        },
        {
          "nro": 3,
          "quien": "Actor",
          "texto": "selecciona la opción Aterrizar Vuelo"
        },
        {
          "nro": 4,
          "quien": "Sistema",
          "texto": "busca los vuelos en condiciones de aterrizar (en zona), muestra número de vuelo y fecha y hora de partida programada, y solicita seleccionarlos"
        },
        {
          "nro": 5,
          "quien": "Actor",
          "texto": "selecciona un vuelo para aterrizar"
        },
        {
          "nro": 6,
          "quien": "Sistema",
          "texto": "solicita confirmación para marcar el vuelo como aterrizado"
        },
        {
          "nro": 7,
          "quien": "Actor",
          "texto": "confirma la actualización"
        },
        {
          "nro": 8,
          "quien": "Sistema",
          "texto": "registra fecha, hora y usuario responsable, actualiza el estado a aterrizado y notifica a los interesados"
        }
      ],
      "alternativos": [
        {
          "id": "A1",
          "texto": "No existen vuelos en el estado buscado"
        },
        {
          "id": "A2",
          "texto": "Selecciona todos los vuelos"
        },
        {
          "id": "A3",
          "texto": "Selecciona varios vuelos"
        },
        {
          "id": "A4",
          "texto": "Despegue (vuelos cerrados)"
        },
        {
          "id": "A5",
          "texto": "En aire (vuelos en despegue)"
        },
        {
          "id": "A6",
          "texto": "En zona (vuelos en aire)"
        },
        {
          "id": "A7",
          "texto": "Demorado (programados o reprogramados)"
        },
        {
          "id": "A8",
          "texto": "Embarcando (demorados, programados o reprogramados)"
        },
        {
          "id": "A9",
          "texto": "Cerrado (vuelos en embarque)"
        },
        {
          "id": "A11",
          "texto": "Finalizado (vuelos aterrizados)"
        },
        {
          "id": "A12",
          "texto": "El EN cancela el CU"
        }
      ]
    }
  ],
