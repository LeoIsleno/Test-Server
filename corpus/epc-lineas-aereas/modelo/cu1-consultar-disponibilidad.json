  "fuente": "EPC Líneas Aéreas v1.35, págs. 4-6 (CU, curso normal abreviado), 13 (comunicación, 86 mensajes), 14 (vista de clases)",
  "casosDeUso": [
    {
      "id": "CU1",
      "nombre": "Consultar disponibilidad de vuelos",
      "actor": "Pasajero",
      "pasos": [
        {
          "nro": 1,
          "quien": "Actor",
          "texto": "selecciona la opción Consultar disponibilidad de vuelos"
        },
        {
          "nro": 2,
          "quien": "Sistema",
          "texto": "requiere que se indique el Tipo de Vuelo"
        },
        {
          "nro": 3,
          "quien": "Actor",
          "texto": "selecciona Tipo de Vuelo = Sólo Ida"
        },
        {
          "nro": 4,
          "quien": "Sistema",
          "texto": "requiere País de Origen y de Destino"
        },
        {
          "nro": 5,
          "quien": "Actor",
          "texto": "selecciona País de Origen y de Destino"
        },
        {
          "nro": 6,
          "quien": "Sistema",
          "texto": "obtiene las Provincias de los Países seleccionados y requiere Provincia de Origen y de Destino"
        },
        {
          "nro": 7,
          "quien": "Actor",
          "texto": "selecciona Provincia de Origen y de Destino"
        },
        {
          "nro": 8,
          "quien": "Sistema",
          "texto": "muestra Ciudades de las Provincias seleccionadas y requiere Ciudad de Origen y de Destino"
        },
        {
          "nro": 9,
          "quien": "Actor",
          "texto": "selecciona Ciudad de Origen y de Destino"
        },
        {
          "nro": 10,
          "quien": "Sistema",
          "texto": "solicita si admite flexibilidad en horarios habilitando el ingreso de una fecha"
        },
        {
          "nro": 11,
          "quien": "Actor",
          "texto": "indica que es flexible e indica una fecha"
        },
        {
          "nro": 12,
          "quien": "Sistema",
          "texto": "solicita la Cantidad de Pasajeros por Tipo de Clase"
        },
        {
          "nro": 13,
          "quien": "Actor",
          "texto": "indica la Cantidad de Pasajeros por Tipo de Clase"
        },
        {
          "nro": 14,
          "quien": "Sistema",
          "texto": "permite confirmar la búsqueda"
        },
        {
          "nro": 15,
          "quien": "Actor",
          "texto": "confirma la búsqueda"
        },
        {
          "nro": 16,
          "quien": "Sistema",
          "texto": "verifica que los datos requeridos estén completos"
        },
        {
          "nro": 17,
          "quien": "Sistema",
          "texto": "verifica flexibilidad: HorarioDesde = 0:00, HorarioHasta = 23:59"
        },
        {
          "nro": 18,
          "quien": "Sistema",
          "texto": "verifica Sólo Ida y busca vuelos por ciudad de origen y destino, fecha, horario y butacas disponibles (reservas vigentes y capacidad de la aeronave)"
        },
        {
          "nro": 19,
          "quien": "Sistema",
          "texto": "muestra para cada vuelo: horario y aeropuerto de salida, horario y aeropuerto de llegada, número, duración e importe total"
        }
      ],
      "alternativos": [
        {
          "id": "A1",
          "texto": "Selecciona Ida y Vuelta"
        },
        {
          "id": "A2",
          "texto": "Horarios no flexibles"
        },
        {
          "id": "A3",
          "texto": "No confirma la búsqueda"
        },
        {
          "id": "A4",
          "texto": "Faltan datos obligatorios"
        },
        {
          "id": "A5",
          "texto": "No se encuentran vuelos"
        },
        {
          "id": "A6",
          "texto": "Cancela el CU"
        }
      ]
    }
  ],
