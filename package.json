{
  "name": "profesor-dsi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agente y editor de modelado UML consistente para DSI (UTN FRC)",
  "scripts": {
    "validar": "tsx src/cli/validar.ts",
    "plantuml": "tsx src/cli/plantuml.ts",
